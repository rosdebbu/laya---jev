# ReflexAgent Environment Configuration

# Provider selection for System 1: "auto", "laya", "jev", or "mock"
REFLEX_PROVIDER=auto

# Laya (System 1 Local) Settings
LAYA_MODEL=english         # Options: english, multilingual, typed-decisions
LAYA_DEVICE=cpu            # Options: cpu, cuda
LAYA_PRELOAD=false

# TypeSafe Jev (System 1 Cloud) API Key
TYPESAFE_API_KEY=

# System 2 LLM Provider Settings (Optional - only needed for creative synthesis)
# Supported by LiteLLM: OpenAI, Anthropic, Groq, DeepSeek, Ollama, etc.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gpt-4o-mini

# Agent Control Settings
CONFIDENCE_THRESHOLD=0.75   # Minimum confidence to accept System 1 reflex decision
MAX_ITERATIONS=10           # Maximum agent reasoning loops
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
