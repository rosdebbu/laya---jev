# ReflexAgent Environment Configuration

# Provider selection for System 1: "auto", "laya", "jev", or "mock"
REFLEX_PROVIDER=auto

# Laya (System 1 Local) Settings
LAYA_MODEL=english         # Options: english, multilingual, typed-decisions
LAYA_DEVICE=cpu            # Options: cpu, cuda
LAYA_PRELOAD=false

# TypeSafe Jev (System 1 Cloud) API Key
TYPESAFE_API_KEY=

# System 2 LLM Provider Settings (Google Cloud / Gemini Preferred for Hackathon)
# Supported by LiteLLM: Gemini, OpenAI, Anthropic, Groq, DeepSeek, Ollama
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Sarvam AI - Sovereign Indian Indic Speech & Translation (Hindi, Bengali, Tamil, Telugu, etc.)
# Get API key from https://dashboard.sarvam.ai/
# If left blank, KisanZess automatically falls back to browser Indic Web Speech API (zero-failure guarantee)
SARVAM_API_KEY=

# Agent Control Settings
CONFIDENCE_THRESHOLD=0.75   # Minimum confidence to accept System 1 reflex decision
MAX_ITERATIONS=10           # Maximum agent reasoning loops
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

